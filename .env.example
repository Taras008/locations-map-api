# Значення за замовчуванням для локальної розробки в Docker Compose: docker-compose.yml
# завантажує цей файл, а потім необов'язковий .env, що його перевизначає.
# Для локальних змін: cp .env.example .env (або make env). У production задавайте власні значення.

# --- Django ---
# Модуль налаштувань: config.settings.dev | config.settings.prod (тести завжди використовують config.settings.test)
DJANGO_SETTINGS_MODULE=config.settings.dev
# Секретний ключ. У production — унікальний випадковий рядок ≥ 50 символів
# (prod.py відмовиться стартувати з цим значенням). Згенерувати:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production
# Режим налагодження (у prod.py завжди False)
DJANGO_DEBUG=true
# Дозволені хости через кому. У production залиште localhost, якщо використовується
# Docker healthcheck: він звертається до http://localhost:8000/api/v1/health/
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
# Часовий пояс сервера
TIME_ZONE=Europe/Kyiv

# --- PostgreSQL ---
POSTGRES_DB=locations
POSTGRES_USER=locations
POSTGRES_PASSWORD=locations
# Ім'я сервісу в docker-compose; локально без Docker — localhost
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Скільки секунд тримати з'єднання з БД відкритим (0 — закривати після кожного запиту)
DB_CONN_MAX_AGE=60
# Скільки секунд entrypoint чекає на БД перед стартом
DB_WAIT_TIMEOUT=60

# --- Redis ---
# Кеш, дедуплікація переглядів, throttling
REDIS_URL=redis://redis:6379/0
# Redis для тестів (окрема БД, щоб не чіпати dev-дані)
TEST_REDIS_URL=redis://redis:6379/1
# Таймаут операцій з Redis, секунд (щоб недоступний Redis не блокував запити)
REDIS_SOCKET_TIMEOUT=1.0
REDIS_HEALTHCHECK_TIMEOUT=1.0

# --- Celery ---
# Брокер задач (за замовчуванням — REDIS_URL)
CELERY_BROKER_URL=redis://redis:6379/2
# true — виконувати задачі синхронно, без worker'а
CELERY_TASK_ALWAYS_EAGER=false

# --- Email ---
# Локально листи ловить Mailpit: UI на http://localhost:8025
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Locations Map <noreply@locations.local>
# Адреса фронтенду для посилань у листах (скидання пароля)
FRONTEND_URL=http://localhost:3000
# Термін дії посилання для скидання пароля, секунд (за замовчуванням 24 год)
PASSWORD_RESET_TIMEOUT=86400
# Повтори email-задач при збої SMTP: кількість і базова затримка (секунд, росте експоненційно)
EMAIL_TASK_MAX_RETRIES=3
EMAIL_TASK_RETRY_BACKOFF=10

# --- CORS / CSRF (для SPA на іншому домені), через кому ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Проксі ---
# Кількість довірених проксі (nginx, балансувальник) перед застосунком.
# 0 — X-Forwarded-For ігнорується (IP = REMOTE_ADDR). Завищене значення дозволяє
# клієнтам підробляти IP і обходити throttling.
TRUSTED_PROXY_COUNT=0

# --- API ---
API_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100
# Максимальна довжина коментаря у відгуку (символів)
REVIEW_COMMENT_MAX_LENGTH=2000

# --- Popularity ---
# bayes      = (sum(ratings) + M * C) / (reviews_count + M)
# quality    = ((bayes - 1) / 4) ^ POWER,   q0 = ((C - 1) / 4) ^ POWER
# popularity = q0 + (quality - q0) * (1 + W_REVIEWS * ln(1 + reviews_count))
#            + quality * W_VIEWS * ln(1 + views_7d)
# M — скільки "віртуальних" відгуків з оцінкою C додається до кожної локації
POPULARITY_BAYES_M=5
POPULARITY_BAYES_C=3.0
POPULARITY_QUALITY_POWER=2.0
POPULARITY_WEIGHT_REVIEWS=1.5
POPULARITY_WEIGHT_VIEWS=1.0
# Вікно для views_7d (днів)
POPULARITY_VIEWS_WINDOW_DAYS=7
# Повторний перегляд локації тим самим відвідувачем протягом N секунд не рахується
LOCATION_VIEW_DEDUP_TTL=3600
# Ліміти запитів (формат N/second|min|hour|day)
THROTTLE_ANON=60/min
THROTTLE_USER=300/min
THROTTLE_LOGIN=10/min
# Спроби входу на один акаунт (email) з будь-яких IP
THROTTLE_LOGIN_EMAIL=5/min
THROTTLE_REGISTER=5/hour
THROTTLE_PASSWORD_RESET=5/hour
# Окремо від запиту листа: помилка в новому паролі не блокує повторний запит
THROTTLE_PASSWORD_RESET_CONFIRM=10/hour
THROTTLE_EXPORT=10/min

# --- Логування ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json — структуровані логи (production), text — зручно читати локально
LOG_FORMAT=text

# --- Gunicorn ---
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=30

# --- Лише для prod.py ---
# Редірект на HTTPS (вимкніть, якщо TLS термінується і редірект робить проксі)
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# --- Порти на хості ---
WEB_PORT=8000
MAILPIT_UI_PORT=8025
